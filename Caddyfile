# PIOS 리버스 프록시. 도메인은 .env의 PIOS_DOMAIN (개발 기본: localhost → Caddy 내부 CA TLS)
{
	# 필요 시 ACME 이메일: email you@example.com
}

{$PIOS_DOMAIN:localhost} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# SPA: Vite 번들(self) + Pretendard(cdn.jsdelivr.net CSS/폰트). 인라인 style 속성(Recharts/Radix)은 'unsafe-inline' 필요.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		-Server
	}

	# 내부 전용 introspect는 외부에 노출하지 않는다 (MCP -> backend 내부망 호출만)
	@introspect path /api/oauth/introspect*
	handle @introspect {
		respond "Not Found" 404
	}

	# OAuth Authorization Server 메타데이터 (RFC 8414) -> backend
	@as_metadata path /.well-known/oauth-authorization-server*
	handle @as_metadata {
		reverse_proxy backend:8080
	}

	# OAuth Protected Resource 메타데이터 (RFC 9728) -> mcp
	@pr_metadata path /.well-known/oauth-protected-resource*
	handle @pr_metadata {
		reverse_proxy mcp:8001
	}

	# Caddy는 Host를 원본 그대로 전달하고 X-Forwarded-For/Proto/Host를 자동 설정한다.
	handle /api* {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle /mcp* {
		reverse_proxy mcp:8001 {
			header_up X-Real-IP {remote_host}
			# 스트리밍(SSE) 응답을 즉시 flush
			flush_interval -1
		}
	}

	handle {
		reverse_proxy frontend:8080
	}
}
