# ===== 도메인 / 공개 URL =====
# Caddy가 인증서를 발급받을 도메인 (개발: localhost)
PIOS_DOMAIN=localhost
# 외부에서 접근하는 기준 URL. OAuth issuer가 된다 (끝에 / 없이)
PIOS_PUBLIC_BASE_URL=https://localhost
# (참고) PIOS_MCP_RESOURCE_URL(=${PIOS_PUBLIC_BASE_URL}/mcp)과 PIOS_FRONTEND_BASE_URL(=PIOS_PUBLIC_BASE_URL)은
# docker-compose.yml에서 자동 파생된다. 직접 실행(비 Docker) 시에만 환경변수로 지정.
# CORS 허용 Origin (쉼표 구분, 필수). 운영: PIOS_PUBLIC_BASE_URL과 동일하게
PIOS_CORS_ALLOWED_ORIGINS=https://localhost

# ===== 시크릿 (모두 필수) =====
# 생성: openssl rand -base64 48
JWT_SECRET=change-me
# 저장 시 암호화(LLM API 키, Garmin 비밀번호) 키 재료. JWT_SECRET과 다른 값 사용
PIOS_ENCRYPTION_KEY=change-me
# 암호화 키 교체 시에만 이전 키 값 (재암호화 완료 로그 확인 후 비움)
PIOS_ENCRYPTION_KEY_LEGACY=
# backend <-> MCP 서버 내부 공유 시크릿 (32자 이상). 생성: openssl rand -base64 48
PIOS_MCP_INTERNAL_SECRET=change-me
# Postgres 비밀번호 (기존 볼륨은 최초 초기화 시점의 비밀번호를 유지함)
POSTGRES_PASSWORD=change-me

# ===== 기능 플래그 =====
PIOS_REGISTRATION_ENABLED=false
PIOS_MOCK_DATA_ENABLED=false

# ===== 외부 서비스 =====
# OpenAI (선택) — 비우면 사용자별 OpenAI Provider 키 또는 Fallback 응답 사용
OPENAI_API_KEY=
# OpenAI 호환 엔드포인트/모델 (선택, 기본값: https://api.openai.com/v1, gpt-4o-mini)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Neo4j (필수) — 예: neo4j+s://xxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
