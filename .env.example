# OpenAI API Key (optional - for LLM insights)
OPENAI_API_KEY=sk-your-key-here

# JWT Secret (필수). 생성: openssl rand -base64 48
JWT_SECRET=

# AES key material for secrets at rest (LLM API keys, Garmin passwords). 필수, JWT_SECRET과 다른 값 사용.
# 생성: openssl rand -base64 48
PIOS_ENCRYPTION_KEY=

# 암호화 키 교체 시 이전 키 값. 기동 시 이전 키로 암호화된 비밀값을 새 키로 재암호화한다.
# 재암호화 완료 로그 확인 후 비워도 된다.
PIOS_ENCRYPTION_KEY_LEGACY=

# 회원가입 허용 여부 (기본 false)
PIOS_REGISTRATION_ENABLED=false

# Postgres 비밀번호 (기존 볼륨은 최초 초기화 시점의 비밀번호를 유지함)
POSTGRES_PASSWORD=pios123

# Neo4j Cloud Connection (optional - if not using local neo4j container)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# MCP Server API Key (pios_... , MCP 설정 화면에서 발급)
PIOS_MCP_API_KEY=
